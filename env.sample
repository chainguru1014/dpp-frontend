PORT=3000
REACT_APP_API_BASE_URL=https://api.innosynch.com
REACT_APP_BACKEND_URL=https://api.innosynch.com
REACT_APP_SOCKET_URL=https://api.innosynch.com
REACT_APP_WEB_BASE_URL=https://dpp.innosynch.com
REACT_APP_SECURITY_BASE_URL=https://dpp.innosynch.com
REACT_APP_GOOGLE_CLIENT_ID=
# Sign in with Apple: a Services ID (not the app/bundle id) + its registered
# web redirect URI, from the Apple Developer portal (Certificates, Identifiers
# & Profiles -> Identifiers -> Services IDs). Not set up yet — see
# src/features/auth/useAppleAuth.js for the placeholder fallback.
REACT_APP_APPLE_CLIENT_ID=
REACT_APP_APPLE_REDIRECT_URI=

# Optional. A Google Cloud "Maps JavaScript API" key. With it, Product Activity
# draws its map on Google Maps; without it, on OpenStreetMap.
REACT_APP_GOOGLE_MAPS_KEY=
